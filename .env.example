# LLM provider: demo | openrouter | vllm | llamacpp | openai_compat
LLM_BACKEND=demo

# OpenRouter — set LLM_BACKEND=openrouter for a real request.
# Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_HTTP_REFERER=http://localhost:8787
OPENROUTER_APP_TITLE=IFURI Digital Twin Lab

# Generic OpenAI-compatible/local backends
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=6200
LLM_TEMPERATURE=0
LLM_REPAIR_ATTEMPTS=2

# Digital twin/source ingestion
SOURCES_DIR=/app/sources
TWIN_STATE_DIR=/app/state
SOURCE_MAX_FILES=64
SOURCE_MAX_CHARS=120000

# Fabric / persistence
NATS_HOST=nats
NATS_PORT=4222
POSTGRES_DSN=postgresql://ifuri:ifuri@postgres:5432/ifuri

# Guarded live evolution loop. Keep observe until the policy/tests are reviewed.
EVOLUTION_ENABLED=1
EVOLUTION_MODE=observe
EVOLUTION_LLM_BACKEND=openrouter
EVOLUTION_OPENROUTER_MODEL=qwen/qwen3-coder-next
EVOLUTION_APP_PORT=18787
EVOLUTION_BIND_ADDRESS=127.0.0.1
EVOLUTION_POLL_SECONDS=2
EVOLUTION_TEST_TIMEOUT_SECONDS=180

# Startup TestQL verification (one-shot service in the evolution profile).
TESTQL_TWIN_URL=http://127.0.0.1:7444
TESTQL_TWIN_PROJECT_DIR=../../bioxfoundry/projects/nanobionic-laboratory-md
TESTQL_STARTUP_WAIT_SECONDS=45

# Optional host port overrides for the regular Compose stack.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8787
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
NATS_BIND_ADDRESS=127.0.0.1
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
