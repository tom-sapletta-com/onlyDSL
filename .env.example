# LLM provider: demo | openrouter | vllm | llamacpp | openai_compat
LLM_BACKEND=demo

# OpenRouter — set LLM_BACKEND=openrouter for a real request.
# Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_HTTP_REFERER=http://localhost:8787
OPENROUTER_APP_TITLE=IFURI Digital Twin Lab

# Generic OpenAI-compatible/local backends
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=6200
LLM_TEMPERATURE=0
LLM_REPAIR_ATTEMPTS=2

# Digital twin/source ingestion
SOURCES_DIR=/app/sources
TWIN_STATE_DIR=/app/state
SOURCE_MAX_FILES=64
SOURCE_MAX_CHARS=120000

# Fabric / persistence
NATS_HOST=nats
NATS_PORT=4222
POSTGRES_DSN=postgresql://ifuri:ifuri@postgres:5432/ifuri
