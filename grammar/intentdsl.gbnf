# IntentDSL v1 response grammar.
# The LLM must return one fenced Markdown block; no prose can be emitted around it.
root ::= "```intentdsl" nl intent (input | state | rule | forbid | output)+ "```"

intent ::= "INTENT " ident nl
input ::= "INPUT " ident " " type nl
state ::= "STATE " ident " " type " = " literal nl
forbid ::= "FORBID " expr nl
output ::= "OUTPUT " ident nl?

rule ::= "RULE " ident nl rule-stmt+ "END" nl
rule-stmt ::= "  WHEN " expr nl
            | "  DO " call nl
            | "  SET " ident " = " expr nl
            | "  EMIT " call nl
            | "  ASSERT " expr nl
            | "  STOP" nl

type ::= "string" | "number" | "integer" | "boolean"
ident ::= [a-zA-Z_][a-zA-Z0-9_]*
call ::= ident | ident "(" args? ")"
args ::= arg ("," space? arg)*
arg ::= ident "=" literal
literal ::= string | number | boolean
string ::= "\"" string-char* "\""
string-char ::= [^"\\\n] | "\\" ["\\nrt]
number ::= "-"? ([0-9]+ ("." [0-9]+)?)
boolean ::= "true" | "false"
expr ::= [^\n]+
nl ::= "\n"
space ::= " "
